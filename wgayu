#!/bin/bash
# ==========================================
# wgayu - WireGuard Ayu Management CLI
# ==========================================

WG_DIR="/etc/wireguard"
WG_CONF="$WG_DIR/wg0.conf"
BASE_CONF="$WG_DIR/wg0.conf.base"
PEERS_DIR="$WG_DIR/peers.d"
CLIENTS_DIR="$WG_DIR/clients"
ENDPOINT="vpn.yugayu.com:51820"
DNS_SERVER="10.0.0.61"

rebuild() {
    echo "⚙️  Rebuilding WireGuard configuration..."
    cat "$BASE_CONF" "$PEERS_DIR"/*.conf > "$WG_CONF" 2>/dev/null || cat "$BASE_CONF" > "$WG_CONF"
    chmod 600 "$WG_CONF"
    systemctl restart wg-quick@wg0
    echo "✅ Server rebuilt and restarted successfully."
}

add_peer() {
    if [ -z "$1" ]; then echo "❌ Error: Missing peer name."; exit 1; fi
    CLIENT_NAME=$1
    SERVER_PUB=$(wg show wg0 public-key)
    LAST_IP=$(grep -oP 'AllowedIPs\s*=\s*10\.100\.0\.\K\d+' "$WG_DIR"/peers.d/*.conf 2>/dev/null | sort -n | tail -1)
    if [ -z "$LAST_IP" ]; then NEXT_IP=2; else NEXT_IP=$((LAST_IP + 1)); fi
    CLIENT_IP="10.100.0.${NEXT_IP}/32"

    echo "🔑 Generating keys for $CLIENT_NAME ($CLIENT_IP)..."
    CLIENT_PRIV=$(wg genkey)
    CLIENT_PUB=$(echo "$CLIENT_PRIV" | wg pubkey)

    cat <<EOF > "$PEERS_DIR/${CLIENT_NAME}_peer.conf"
[Peer]
# $CLIENT_NAME
PublicKey = $CLIENT_PUB
AllowedIPs = $CLIENT_IP
EOF

    cat <<EOF > "$CLIENTS_DIR/${CLIENT_NAME}_full.conf"
[Interface]
PrivateKey = $CLIENT_PRIV
Address = $CLIENT_IP
DNS = $DNS_SERVER

[Peer]
PublicKey = $SERVER_PUB
Endpoint = $ENDPOINT
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
EOF

    cat <<EOF > "$CLIENTS_DIR/${CLIENT_NAME}_split.conf"
[Interface]
PrivateKey = $CLIENT_PRIV
Address = $CLIENT_IP
DNS = $DNS_SERVER

[Peer]
PublicKey = $SERVER_PUB
Endpoint = $ENDPOINT
AllowedIPs = 10.0.0.0/24, 10.100.0.0/24
PersistentKeepalive = 25
EOF

    rebuild
    echo "✅ Peer '$CLIENT_NAME' created successfully!"
    echo ""
    show_qr "$CLIENT_NAME"
}

remove_peer() {
    rm -f "$PEERS_DIR/${1}_peer.conf" "$CLIENTS_DIR/${1}_"*
    rebuild
}

show_qr() {
    if [ ! -f "$CLIENTS_DIR/${1}_full.conf" ]; then
        echo "❌ Error: Client '$1' not found."
        return 1
    fi
    
    echo "📱 FULL TUNNEL QR CODE (Routes ALL traffic through VPN):"
    qrencode -t ansiutf8 < "$CLIENTS_DIR/${1}_full.conf"
    
    echo ""
    read -p "➡️  Press [Enter] to show the SPLIT TUNNEL QR code..."
    echo ""
    
    echo "📱 SPLIT TUNNEL QR CODE (Routes ONLY Home Network through VPN):"
    qrencode -t ansiutf8 < "$CLIENTS_DIR/${1}_split.conf"
}

update_cli() {
    echo "🔄 Pulling the latest version of wgayu from GitHub..."
    
    # 1. Download to a temporary file so we don't break the running script
    curl -sL https://raw.githubusercontent.com/yuga-ayu/wireguard-ayu/main/wgayu -o /tmp/wgayu_tmp
    
    # 2. Make it executable
    chmod +x /tmp/wgayu_tmp
    
    # 3. Swap it in (this safely replaces the file inode instantly)
    mv /tmp/wgayu_tmp /usr/local/bin/wgayu
    
    echo "✅ Update complete!"
}

list_peers() {
    echo "📋 Current WireGuard Peers:"
    echo "---------------------------"
    # Check if the directory exists and has files
    if [ ! -d "$PEERS_DIR" ] || [ -z "$(ls -A "$PEERS_DIR" 2>/dev/null)" ]; then
        echo " No active peers found."
    else
        # Loop through the files, strip the extension, and grab the IP
        ls -1 "$PEERS_DIR" | grep '_peer\.conf$' | sed 's/_peer\.conf//' | while read peer; do
            IP=$(grep -oP 'AllowedIPs\s*=\s*\K.*' "$PEERS_DIR/${peer}_peer.conf" 2>/dev/null)
            echo " - $peer ($IP)"
        done
    fi
    echo "---------------------------"
}

check_dependencies() {
    for cmd in wg qrencode curl iptables; do
        if ! command -v "$cmd" &> /dev/null; then
            echo "⚠️  Warning: '$cmd' is not installed. Some features may not work."
            echo "👉 Run: sudo apt install -y wireguard qrencode curl iptables"
        fi
    done
}

init_env() {
    check_dependencies
    mkdir -p "$PEERS_DIR" "$CLIENTS_DIR"
    if [ ! -f "$BASE_CONF" ]; then cp "$WG_CONF" "$BASE_CONF"; fi
    echo "✅ Setup complete."
}

case "$1" in
    add) add_peer "$2" ;;
    remove) remove_peer "$2" ;;
    rebuild) rebuild ;;
    show) show_qr "$2" ;;
    init) init_env ;;
    update) update_cli ;;
    list) list_peers ;;
    *) echo "Usage: wgayu [init|add|remove|list|show|rebuild|update]" ;;
esac
